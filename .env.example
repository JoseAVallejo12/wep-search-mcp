# ==============================================================================
# Web Search & Content Extraction MCP Server Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Configuration (HTTP/SSE)
PORT=3000
HOST=0.0.0.0

# Transport Mode: "sse" (HTTP remote deployment) or "stdio" (local process integration)
MCP_TRANSPORT=sse

# SearXNG Backend URL
# - Inside Docker Compose: http://searxng:8080
# - Local Development outside Docker: http://localhost:8080
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT_MS=8000

# Extraction & Content Cleaning Settings
FETCH_TIMEOUT_MS=10000
DEFAULT_MAX_RESULTS=5
DEFAULT_MAX_TOKENS_PER_PAGE=1000
MAX_ALLOWED_TOKENS_PER_PAGE=4000

# Logging: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info
